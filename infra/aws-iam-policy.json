{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EpochTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:DescribeTable",
        "dynamodb:CreateTable",
        "dynamodb:UpdateTimeToLive"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-central-1:*:table/epoch",
        "arn:aws:dynamodb:eu-central-1:*:table/epoch/index/*"
      ]
    }
  ]
}
